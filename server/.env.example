# Required. Pooled connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Used only by the Prisma CLI for migrations (direct connection, no "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional. Defaults are shown.
# NODE_ENV=development
# PORT=4000
# CLIENT_URL=http://localhost:5173
# LOG_LEVEL=info

# Required. At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

# Optional. Defaults shown.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7