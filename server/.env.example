# Required. Pooled connection string (host contains "-pooler").
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Used only by the Prisma CLI for migrations (direct connection, no "-pooler").
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional. Defaults are shown.
# NODE_ENV=development
# PORT=4000
# CLIENT_URL=http://localhost:5173
# LOG_LEVEL=info